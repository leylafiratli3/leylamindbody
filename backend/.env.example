# Copy to .env for local dev; in production set these as Fly secrets:
#   fly secrets set KEY=value -a leyla-mindbody-api
# ALL of these are server-side only — never put them in frontend code.

# Neon (serverless Postgres) — all store data lives here
DATABASE_URL=

# Supabase — AUTH ONLY (accounts, sessions, password resets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification: set the legacy HS256 secret (Project Settings → API → JWT Secret)...
SUPABASE_JWT_SECRET=
# ...or, if your project uses asymmetric signing keys, a JWKS URL instead:
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# Stripe (US account; USD on /en, TRY on /tr)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bunny Stream (token authentication + referrer lock must be enabled — see README)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=

# Resend (transactional email; EMAIL_FROM must use a verified domain)
RESEND_API_KEY=
EMAIL_FROM="Leyla <hello@mindbodyhealingwithleyla.com>"

# Public site URL (success/cancel redirects, email links)
APP_URL=https://mindbodyhealingwithleyla.com

# Existing free-class signup admin (unchanged)
ADMIN_PASSWORD=
